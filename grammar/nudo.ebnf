(* NUDO grammar — EBNF                                                     *)
(*                                                                        *)
(* STATUS: PRE-ALPHA. Two layers, with different standing:                 *)
(*                                                                        *)
(*   LEXICAL GRAMMAR    IMPLEMENTED   milestone M1, compiler/nudo-lexer    *)
(*   SYNTACTIC GRAMMAR  IMPLEMENTED   milestone M2, compiler/nudo-parser   *)
(*                                                                        *)
(* "Implemented" means the reference parser accepts exactly these           *)
(* productions and rejects the rest with NDO1001. It does not mean the      *)
(* language is finished: the productions marked provisional can still       *)
(* change, and each change needs a NEP. Nothing is type-checked (M3) and    *)
(* nothing runs (M4).                                                      *)
(*                                                                        *)
(* Where this file and an example disagree, this file wins: the examples    *)
(* are illustrations and say which of them the toolchain can read. The      *)
(* known disagreements are listed in spec/grammar.md.                      *)
(*                                                                        *)
(* The normative narrative is spec/grammar.md and the chapters it links.    *)
(* If this file and the specification disagree, the specification wins.     *)
(*                                                                        *)
(* Two rules below are load-bearing and are checked mechanically by         *)
(* scripts/check-grammar.py:                                                *)
(*                                                                        *)
(*   1. NO LEFT RECURSION. nudo-parser will be a recursive-descent parser,  *)
(*      which cannot handle a production that derives a form starting with  *)
(*      itself, directly or indirectly.                                     *)
(*   2. NO UNSTATED PRECEDENCE. The PRECEDENCE marker is the single source  *)
(*      of operator precedence; the productions must implement it, and the  *)
(*      identical marker appears in grammar/syntax-reference.md and         *)
(*      spec/expressions.md. The checker compares all three.                *)
(*                                                                        *)
(* Notation:                                                               *)
(*   rule = ... ;        a production                                      *)
(*   a , b               a followed by b                                   *)
(*   a | b               a or b                                            *)
(*   [ a ]               optional                                         *)
(*   { a }               zero or more repetitions                          *)
(*   "text"              a literal token                                   *)
(*   ? ... ?             a special sequence: prose, or an unspecified input *)
(*   comment             text between the comment delimiters              *)

(* ===================================================================== *)
(* LEXICAL GRAMMAR                                          IMPLEMENTED  *)
(* ===================================================================== *)
(* Normative text: spec/lexical-structure.md. Implemented by             *)
(* compiler/nudo-lexer; covered by tests/conformance/lexer.              *)

source-file         = { trivia | token }, eof ;

trivia              = whitespace | line-comment | block-comment ;

whitespace          = ? any Unicode whitespace character ? ;

line-comment        = "//", { ? any character except a line terminator ? } ;

block-comment       = "/*", { block-comment-body }, "*/" ;
block-comment-body  = ? any character ? | block-comment ;

eof                 = ? end of file ? ;

identifier          = identifier-start, { identifier-continue } ;
identifier-start    = letter | "_" ;
identifier-continue = letter | digit | "_" ;
letter              = ? "A" through "Z", or "a" through "z" ? ;
digit               = ? "0" through "9" ? ;

integer-literal     = digit, { separator-digit } ;
separator-digit     = digit | ( "_", digit ) ;

float-literal       = integer-literal, ".", digit, { separator-digit } ;

text-literal        = '"', { text-character | escape-sequence }, '"' ;
text-character      = ? any character except a quote, a backslash,
                        or a line terminator ? ;
escape-sequence     = "\", ( "n" | "r" | "t" | "\" | '"' | "0" ) ;

(* The reserved core, decided by NEP-0005. Every other word the grammar uses  *)
(* (`agent`, `task`, `tool`, `model`, `role`, `tools`, `allow`, `budget`,      *)
(* `with`, `verify`, `ask`, `delegate`) is contextual: it introduces its       *)
(* construct in position and stays an identifier elsewhere, so a program may   *)
(* still have a binding named `agent`. The parser, not the lexer, recognises   *)
(* those. See neps/0005-keyword-policy.md and spec/lexical-structure.md.      *)
keyword             = "fn" | "let" | "struct" | "enum" | "if" | "else"
                    | "match" | "const" | "true" | "false" ;

(* Punctuation of the pre-alpha token set. *)
punctuation         = "(" | ")" | "{" | "}" | "[" | "]" | ":" | "," | "::"
                    | "->" | "=>" | "." | "?" | "=" | "==" | "!="
                    | "<" | ">" | "<=" | ">=" | "&&" | "||" | "!"
                    | "+" | "-" | "*" | "/" | ";" ;

token               = identifier | integer-literal | float-literal
                    | text-literal | keyword | punctuation ;

(* ===================================================================== *)
(* SYNTACTIC GRAMMAR                                        SPECIFIED    *)
(* ===================================================================== *)
(* PRE-ALPHA. Proposed syntax, not implemented. Milestone M2.            *)

program             = { item } ;

item                = function-decl
                    | struct-decl
                    | enum-decl
                    | agent-decl
                    | task-decl
                    | tool-decl
                    | model-decl
                    | const-decl
                    | binding ;

(* ---------------------------------------------------------------- items *)

function-decl       = "fn", identifier, [ generic-parameter-list ], parameter-list,
                      [ "->", type ], [ effect-clause ], block ;

generic-parameter-list = "<", identifier, { ",", identifier }, ">" ;

(* A declaration states its parameters: `fn identity<T>(value: T) -> T`,
   `enum Outcome<T, E> { … }`. One token of lookahead is still enough, because
   after a declaration's name `<` can start nothing else. See NEP-0010. *)

parameter-list      = "(", [ parameter, { ",", parameter } ], ")" ;
parameter           = identifier, ":", type ;

effect-clause       = "with", capability-list ;
capability-list     = capability, { ",", capability } ;
capability          = identifier ;

struct-decl         = "struct", identifier, [ generic-parameter-list ],
                      "{", { field }, "}" ;
field               = identifier, ":", type ;

enum-decl           = "enum", identifier, [ generic-parameter-list ],
                      "{", { variant }, "}" ;
variant             = identifier, [ "(", [ field, { ",", field } ], ")" ] ;

const-decl          = "const", identifier, ":", type, "=", expression, ";" ;

binding             = "let", identifier, [ ":", type ], "=", expression, ";" ;

(* --------------------------------------------------- agents and tasks *)

agent-decl          = "agent", identifier, "{", { agent-clause }, "}" ;
agent-clause        = role-clause | tools-clause | allow-clause | budget-clause ;
role-clause         = "role", ":", text-literal ;
tools-clause        = "tools", ":", tool-name, { ",", tool-name } ;
allow-clause        = "allow", ":", capability-list ;
tool-name           = path ;

task-decl           = "task", identifier, [ generic-parameter-list ], parameter-list,
                      "->", type, "{", { task-clause }, "}" ;
task-clause         = agent-clause
                    | "agent", ":", path
                    | verify-clause
                    | budget-clause ;
verify-clause       = "verify", ":", path ;

budget-clause       = "budget", ":", budget-literal ;
budget-literal      = "Budget", "(", budget-field, { ",", budget-field }, ")" ;
budget-field        = identifier, ":", expression ;

tool-decl           = "tool", path, [ generic-parameter-list ], parameter-list,
                      [ "->", type ], [ effect-clause ], block ;

model-decl          = "model", identifier, "{", { model-field }, "}" ;
model-field         = identifier, ":", expression ;

(* ---------------------------------------------------------------- types *)

type                = primary-type, [ "?" ] ;

primary-type        = path-type
                    | generic-type
                    | sequence-type
                    | function-type
                    | parenthesized-type ;

path-type           = path ;
generic-type        = path, "<", type, { ",", type }, ">" ;
sequence-type       = "[", type, "]" ;
function-type       = "Fn", "(", [ type, { ",", type } ], ")", "->", type ;
parenthesized-type  = "(", type, ")" ;

(* A type is at most one level of optional: `T?` is valid, `T??` is not,
   and `(T?)?` is valid because parentheses reset the level. `primary-type`
   does not include a trailing `?`, so this is not left-recursive.

   The parser needs one token of lookahead to choose between `path-type`
   and `generic-type` (`Foo` versus `Foo<...>`). That is the only lookahead
   the type grammar requires, and it is recorded in
   docs/internals/parser-design.md. *)

(* ----------------------------------------------------------- expressions *)

(* PRECEDENCE: expression > logical-or > logical-and > equality > comparison > additive > multiplicative > unary-expression > postfix-expression > primary-expression *)

(* The chain above is the single definition of operator precedence. Each
   level is defined in terms of the next, so the grammar and the precedence
   cannot disagree; scripts/check-grammar.py verifies both that and the fact
   that the same text appears in grammar/syntax-reference.md and
   spec/expressions.md.

   There is deliberately no `assignment` level. An assignment expression
   requires a mutable binding, and whether NUDO has mutable bindings at all is
   an open question (spec/declarations.md). When it is answered, assignment
   takes the place above `logical-or`, and a NEP records it. *)

expression          = logical-or ;

logical-or          = logical-and, { "||", logical-and } ;

logical-and         = equality, { "&&", equality } ;

equality            = comparison, { equality-operator, comparison } ;
equality-operator   = "==" | "!=" ;

(* Comparison does not chain: `a < b < c` is a syntax error rather than a
   silent `(a < b) < c`. Use an explicit `&&` between comparisons. *)
comparison          = additive, [ comparison-operator, additive ] ;
comparison-operator = "<" | ">" | "<=" | ">=" ;

additive            = multiplicative, { additive-operator, multiplicative } ;
additive-operator   = "+" | "-" ;

multiplicative      = unary-expression, { multiplicative-operator, unary-expression } ;
multiplicative-operator = "*" | "/" ;

unary-expression    = prefix-operator, unary-expression
                    | postfix-expression ;
prefix-operator     = "-" | "!" ;

postfix-expression  = primary-expression, { postfix-suffix } ;
postfix-suffix      = argument-list
                    | field-access
                    | index-access ;
argument-list       = "(", [ expression, { ",", expression } ], ")" ;
field-access        = ".", identifier ;
index-access        = "[", expression, "]" ;

(* Left-associative postfix chaining is what makes `a.b(c)[d]` one
   expression. There is no `?` suffix: `?` is a type operator in the
   pre-alpha design, and expression-level error propagation is an open
   question that needs a NEP before it has syntax. *)

primary-expression  = literal
                    | path-expression
                    | parenthesized-expression
                    | block
                    | if-expression
                    | match-expression
                    | ask-expression
                    | verify-expression
                    | delegate-expression ;

literal             = integer-literal | float-literal | text-literal
                    | "true" | "false" ;

path                = path-segment, { "::", path-segment } ;
path-segment        = identifier ;
path-expression     = path ;

parenthesized-expression = "(", expression, ")" ;

(* A block is a statement list with an optional final expression, which is
   the block's value. Every statement other than the final expression is
   terminated by `;`, which keeps the rule decidable without backtracking. *)
block               = "{", { block-statement }, [ expression ], "}" ;
block-statement     = binding | expression-statement ;
expression-statement = expression, ";" ;

if-expression       = "if", expression, block,
                      [ "else", ( block | if-expression ) ] ;

(* `match` is unambiguous without lookahead: a block is a primary
   expression, never a postfix suffix, so the scrutinee expression cannot
   swallow the `{` that opens the arms. *)
match-expression    = "match", expression, "{", { match-arm }, "}" ;
match-arm           = pattern, "=>", expression ;
pattern             = path, [ "(", [ pattern, { ",", pattern } ], ")" ] ;

(* The agentic expressions. All three are provisional: NEP-0001, NEP-0002
   and NEP-0006 decide whether they are keywords, functions or protocols.

   `with` is not an operator. It appears only in `effect-clause`,
   `verify-expression` and `delegate-expression`, which is what keeps
   `verify draft with V` parseable: no postfix suffix starts with `with`. *)
ask-expression      = "ask", path, block ;

(* The operand is a NAMED value: a path, optionally called. That restriction is
   what lets the parser read `verify` as a verification with one token of
   lookahead: `verify draft with V` is a verification, and `verify(draft)` is a
   call on a name called `verify`. A parenthesised or compound operand is not in
   the grammar. See NEP-0002. *)
verify-expression   = "verify", verified-operand, "with", path ;
verified-operand    = path, [ argument-list ] ;

delegate-expression = "delegate", path, block,
                      [ "with", "budget", ":", budget-literal ] ;
