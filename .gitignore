# Rust build output
/target
**/*.rs.bk
*.pdb

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Book: generated on every build, never committed.
/book/output/
/book/i18n/*/output/
/book/typst/generated/

# Book: the official logos are copied here by book/scripts/sync_brand_assets.py
# at build time, so the repository keeps exactly one copy of each asset.
/book/src/assets/brand/*.png
/book/typst/assets/brand/*.png

# Book: diagrams are shared from book/src/diagrams and copied into each
# language tree by book/scripts/build_site.py.
/book/i18n/*/src/diagrams/
/book/i18n/*/theme/

# Python bytecode from the book's helper scripts
__pycache__/

# Local scratch
/.openclaw/
