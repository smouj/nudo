// NUDO example 03 — types.
//
// READ BY THE TOOLCHAIN TODAY:
//
//     nudo check examples/03-types/main.nudo
//
// This file uses only syntax the frozen grammar accepts: declarations,
// variants with fields, and a `match` with patterns (spec/types.md,
// spec/declarations.md). It does not run, and nothing here is type-checked:
// the type checker is milestone M3 and the interpreter is M4.

struct User {
    name: Text
    age: Int
}

enum Status {
    Pending
    Running
    Complete
    Failed(reason: Text)
}

fn describe(status: Status) -> Text {
    match status {
        Pending => "not started"
        Running => "in progress"
        Complete => "finished"
        Failed(reason) => reason
    }
}
