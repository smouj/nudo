// NUDO example 03 — types.
//
// READ BY THE TOOLCHAIN TODAY:
//
//     nudo check examples/03-types/main.nudo
//
// This file uses accepted syntax: declarations, variants with fields, and a
// `match` with patterns (spec/types.md, spec/declarations.md). The type checker
// supports these rules, but `nudo check` does not invoke it yet. It does not run
// because the interpreter is milestone M4.

struct User {
    name: Text
    age: Int
}

enum Status {
    Pending
    Running
    Complete
    Failed(reason: Text)
}

fn describe(status: Status) -> Text {
    match status {
        Pending => "not started"
        Running => "in progress"
        Complete => "finished"
        Failed(reason) => reason
    }
}
