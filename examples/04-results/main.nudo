// NUDO example 04 — errors are values.
//
// READ BY THE TOOLCHAIN TODAY:
//
//     nudo check examples/04-results/main.nudo
//
// The file uses only syntax and names the pre-alpha toolchain accepts. It does
// not run, and nothing here is type-checked: the type checker is milestone M3
// and the interpreter is M4.
//
// NUDO has no exceptions, and no `return` either (NEP-0012). A failure is a
// value the caller must handle, and `match` must be exhaustive; a function's
// result is the value of its body, and `match` is an expression, so `report`
// returns its `match` directly (spec/expressions.md).
//
// One half of the story is a comment rather than an invented API: *building* a
// failure — using an enum variant as a value, `Outcome::Err("...")`, or the
// intrinsic `Result::Err` — is not resolved by name resolution yet (M3.2).
// Handling a failure is, and that is what this example shows.

enum Outcome<T, E> {
    Ok(value: T)
    Err(error: E)
}

fn report(outcome: Outcome<Int, Text>) -> Text {
    match outcome {
        Ok(value) => "division succeeded"
        Err(reason) => reason
    }
}

fn value_or(outcome: Outcome<Int, Text>, fallback: Int) -> Int {
    match outcome {
        Ok(value) => value
        Err(reason) => fallback
    }
}
